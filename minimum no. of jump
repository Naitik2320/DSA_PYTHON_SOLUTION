class Solution:
    def minJumps(self, arr):
        n = len(arr)
        
        # If first element is 0, cannot move
        if arr[0] == 0:
            return -1
        
        jumps = 0
        current_end = 0
        farthest = 0
        
        for i in range(n - 1):
            
            # Update farthest we can reach
            farthest = max(farthest, i + arr[i])
            
            # If we reached end of current jump range
            if i == current_end:
                jumps += 1
                current_end = farthest
                
                # If we can't move further
                if current_end <= i:
                    return -1
                
                # If we can already reach last index
                if current_end >= n - 1:
                    return jumps
        
        return -1
	    
